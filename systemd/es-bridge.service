[Unit]
Description=Epson scanner event bridge (es2netif -> Unix socket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/es-bridge -c /etc/es-bridge.conf
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=es-bridge
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
# es2netif needs /tmp/epsonWork shared with anything else using the scanner,
# so PrivateTmp stays off.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
